# Copy to .env at project root. Scripts and Docker load this file.
APP_MODE=demo
GNANI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DATA_GOV_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# Confirm this V3 voice with your account in Punjabi before your recorded demo.
GNANI_TTS_VOICE=Prakash
GNANI_TTS_MODEL=timbre-v3.0
DATABASE_PATH=runtime/mandimitra.db
API_BASE_URL=http://127.0.0.1:8000
APP_PUBLIC_URL=http://localhost:3000
# Hosted Compose only: domain without https:// or a trailing slash.
APP_DOMAIN=
NEXT_TELEMETRY_DISABLED=1
# Local demo only defaults exist; replace all three before hosting.
API_INTERNAL_TOKEN=
APP_ACCESS_CODE=
APP_SESSION_SECRET=
DEPLOYMENT_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
